# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in the Vercel project settings.
# See README.technical.md for exactly where to find these values.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed locally to run scripts/create-users.mjs (creating the first
# logins). NEVER prefix this with NEXT_PUBLIC_, and never commit it or set
# it in a client-exposed context — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
